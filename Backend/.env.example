# Flask Configuration
# Options: development, testing, production
FLASK_ENV=development
FLASK_DEBUG=false
FLASK_APP=app

# ===== SECURITY - CRITICAL =====
# These MUST be changed in production!
# Generate strong secrets with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# ===== DATABASE =====
# Development: SQLite (default)
# Production: PostgreSQL recommended
# Examples:
#   SQLite: sqlite:///ecommerce.db
#   PostgreSQL: postgresql://user:password@localhost:5432/ecommerce
#   PostgreSQL via env var workaround: postgresql+psycopg2://user:password@host:port/db
DATABASE_URL=sqlite:///ecommerce.db

# For production PostgreSQL, you may also set these individual variables:
# DB_USER=postgres
# DB_PASSWORD=your_secure_password
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=ecommerce

# ===== JWT CONFIGURATION =====
# JWT token expiration time in seconds (3600 = 1 hour)
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000
JWT_ALGORITHM=HS256

# ===== CORS CONFIGURATION =====
# Comma-separated list of allowed origins
# Examples:
#   Development: http://localhost:3000,http://localhost:5000
#   Production: https://yourdomain.com,https://api.yourdomain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# ===== RATE LIMITING =====
# Storage backend for rate limiting
# Development: memory:// (in-memory, restart-safe)
# Production: Redis URL (distributed, recommended)
# Examples:
#   Memory: memory://
#   Redis local: redis://localhost:6379
#   Redis with auth: redis://:password@redis-host:6379/0
RATELIMIT_STORAGE_URI=memory://

# Redis connection URL (if using Redis for rate limiting/caching)
REDIS_URL=redis://localhost:6379/0

# ===== PAGINATION SAFETY =====
# Max items per page for list endpoints
MAX_PER_PAGE=100

# ===== REVERSE PROXY =====
# Enable if running behind Nginx/Traefik/etc.
TRUST_PROXY_HEADERS=false
TRUST_PROXY_HOPS=1

# ===== SERVER CONFIGURATION =====
SERVER_HOST=127.0.0.1
SERVER_PORT=5000

# ===== SEED DATA (DEV ONLY) =====
SEED_ADMIN_PASSWORD=AdminPass123!
SEED_USER_PASSWORD=UserPass123!

# ===== LOGGING =====
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ===== EMAIL (SMTP) =====
# Utilisé pour l'envoi des emails de réinitialisation de mot de passe.
# Pour tester en dev, créez un compte gratuit sur https://mailtrap.io
# et copiez les credentials SMTP de votre inbox.
# Pour la production, utilisez votre fournisseur SMTP (Gmail, Mailgun SMTP, etc.)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_mailtrap_user
SMTP_PASSWORD=your_mailtrap_password
# SMTP_FROM=noreply@boutiklakay.com   # Optionnel, défaut: SMTP_USER

# URL du frontend pour construire les liens de reset dans les emails
FRONTEND_URL=http://localhost:5173

# ===== OPTIONAL: THIRD-PARTY SERVICES =====
# Add here if integrating payment gateways, etc.
# Examples:
#   STRIPE_API_KEY=sk_test_...

# ===== SECURITY NOTES =====
# 1. NEVER commit .env files with real secrets to version control
# 2. Always use strong, randomly generated keys in production
# 3. Use environment-specific .env files in production (not .env but /etc/app.env)
# 4. Rotate secrets regularly (especially JWT_SECRET_KEY)
# 5. Use HTTPS only in production (SESSION_COOKIE_SECURE=True)
# 6. Restrict CORS origins to your frontend domain only
# 7. Keep rate limiting storage (Redis) behind firewall in production
# 8. Monitor logs for suspicious activity (failed logins, rate limits, errors)
